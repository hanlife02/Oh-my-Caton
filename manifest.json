{
  "manifest_version": 3,
  "name": "Oh my Caton · 卡坦岛资源追踪",
  "version": "0.4.3",
  "description": "实时追踪 BGA 卡坦岛资源，显示村庄、城市、城市改良等级和公开得分，支持本地保存与手动校正。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://boardgamearena.com/*",
        "https://*.boardgamearena.com/*"
      ],
      "js": [
        "src/engine.js",
        "src/parser.js",
        "src/journal.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Oh my Caton"
  }
}
